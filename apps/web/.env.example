# ─── VelionConnect Web (Next.js) ─────────────────────────────────────────────
# Copy to apps/web/.env.local for local development, and never commit the real
# file. Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser, so
# these are read at BUILD time — rebuild the web app after changing them.
#
# The backend API vars (DATABASE_URL, JWT secrets, connector secrets, etc.) live
# in the root .env.example — they are NOT duplicated here. This file holds only
# what the Next.js frontend needs.

# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the NestJS API, INCLUDING the /api/v1 path prefix.
# REST calls (api-client.ts) hit this directly; the realtime hook strips the
# /api/v1 suffix and connects the Socket.IO namespace at the server origin.
# Local dev default (when unset): http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ─── OAUTH (client-side authorize redirects) ─────────────────────────────────
# The channel-connect UI builds Meta / LinkedIn OAuth authorize URLs in the
# browser, so these PUBLIC client identifiers must be exposed to the frontend.
# They are the same app id / client id as META_APP_ID and LINKEDIN_CLIENT_ID in
# the root .env (public identifiers only — never put the secrets here).
NEXT_PUBLIC_META_APP_ID="change-me"
NEXT_PUBLIC_LINKEDIN_CLIENT_ID="change-me"
