# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://velion:velion_dev@localhost:5432/velionconnect?schema=public"

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# AES-256-GCM key for encrypting OAuth tokens at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="change-me-32-byte-hex-encryption-key"

# ─── EMAIL ───────────────────────────────────────────────────────────────────
# Local dev: MailHog (smtp://localhost:1025, UI at http://localhost:8025)
# Production: SendGrid / Resend
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="VelionConnect <noreply@velionconnect.com>"

# ─── AWS / S3 ────────────────────────────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="change-me"
AWS_SECRET_ACCESS_KEY="change-me"
AWS_S3_BUCKET="velionconnect-media-dev"

# ─── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# ─── SOCIAL CONNECTORS ───────────────────────────────────────────────────────
# Meta (Instagram, Facebook, WhatsApp)
META_APP_ID="change-me"
META_APP_SECRET="change-me"
META_WHATSAPP_VERIFY_TOKEN="change-me"

# LinkedIn
LINKEDIN_CLIENT_ID="change-me"
LINKEDIN_CLIENT_SECRET="change-me"

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="change-me"

# ─── INTERNAL ────────────────────────────────────────────────────────────────
# Protects /internal/queues Bull Board dashboard
INTERNAL_API_KEY="change-me"
