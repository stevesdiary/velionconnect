# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://velion:velion_dev@localhost:5432/velionconnect?schema=public"

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# AES-256-GCM key for encrypting OAuth tokens at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="change-me-32-byte-hex-encryption-key"

# ─── EMAIL ───────────────────────────────────────────────────────────────────
# Local dev: MailHog (smtp://localhost:1025, UI at http://localhost:8025)
# Production: SendGrid / Resend
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="VelionConnect <noreply@velionconnect.com>"

# ─── OBJECT STORAGE ──────────────────────────────────────────────────────────
# Supports: s3 | backblaze-b2 | cloudflare-r2  (all use the S3-compatible SDK)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="velionconnect-media-dev"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="change-me"
STORAGE_SECRET_ACCESS_KEY="change-me"

# Custom S3-compatible endpoint (required for Backblaze B2 and Cloudflare R2).
# Leave empty to use AWS S3 auto-discovery.
# B2 example:  https://s3.us-west-004.backblazeb2.com
# R2 example:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=""

# Base public URL for stored objects — no trailing slash.
# Auto-constructed for AWS S3; required for B2 and R2.
# AWS S3:      https://velionconnect-media-dev.s3.us-east-1.amazonaws.com
# B2 (public): https://f004.backblazeb2.com/file/velionconnect-media-dev
# B2 (CDN):    https://media.example.com
# R2 (r2.dev): https://pub-abc123.r2.dev
# R2 (custom): https://media.example.com
STORAGE_PUBLIC_URL=""

# Force path-style URLs. Auto-set to true for backblaze-b2; false for s3 and cloudflare-r2.
# Only override if your setup differs from the provider default.
# STORAGE_FORCE_PATH_STYLE="true"

# ─── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# ─── SOCIAL CONNECTORS ───────────────────────────────────────────────────────
# Meta (Instagram, Facebook, WhatsApp)
META_APP_ID="change-me"
META_APP_SECRET="change-me"
META_WHATSAPP_VERIFY_TOKEN="change-me"

# LinkedIn
LINKEDIN_CLIENT_ID="change-me"
LINKEDIN_CLIENT_SECRET="change-me"

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="change-me"

# ─── INTERNAL ────────────────────────────────────────────────────────────────
# Protects /internal/queues Bull Board dashboard
INTERNAL_API_KEY="change-me"

# ─── WEB (Next.js frontend) ──────────────────────────────────────────────────
# The frontend has its own env file — see apps/web/.env.example. It needs:
#   NEXT_PUBLIC_API_URL            — base API URL incl. /api/v1 (default: http://localhost:3001/api/v1)
#   NEXT_PUBLIC_META_APP_ID        — same public value as META_APP_ID above
#   NEXT_PUBLIC_LINKEDIN_CLIENT_ID — same public value as LINKEDIN_CLIENT_ID above
# Only public identifiers belong there — NEXT_PUBLIC_ vars are exposed to the
# browser, so never put a secret (META_APP_SECRET, LINKEDIN_CLIENT_SECRET, …) in one.
