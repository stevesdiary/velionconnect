# Production environment for the Contabo VPS deployment (docker/docker-compose.prod.yml).
# Copy to docker/.env and fill in real values. Never commit the real file.

# ─── POSTGRES (container credentials, used to build DATABASE_URL below) ───────
POSTGRES_USER="velion"
POSTGRES_PASSWORD="change-me-strong-random-password"
POSTGRES_DB="velionconnect"

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD="change-me-strong-random-password"

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# AES-256-GCM key for encrypting OAuth tokens at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="change-me-32-byte-hex-encryption-key"

# ─── EMAIL ───────────────────────────────────────────────────────────────────
# Production: a real SMTP provider (SendGrid / Resend / etc). No MailHog in prod.
SMTP_HOST="change-me"
SMTP_PORT="587"
SMTP_USER="change-me"
SMTP_PASS="change-me"
EMAIL_FROM="VelionConnect <noreply@velionconnect.com>"

# ─── OBJECT STORAGE ──────────────────────────────────────────────────────────
# Supports: s3 | backblaze-b2 | cloudflare-r2 (all use the S3-compatible SDK)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="velionconnect-media-prod"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="change-me"
STORAGE_SECRET_ACCESS_KEY="change-me"
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# ─── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3001"
# Fill these in once the domain is attached in Dokploy.
API_URL="https://api.your-domain.com"
WEB_URL="https://your-domain.com"
CORS_ORIGINS="https://your-domain.com"

# ─── SOCIAL CONNECTORS ───────────────────────────────────────────────────────
META_APP_ID="change-me"
META_APP_SECRET="change-me"
META_WHATSAPP_VERIFY_TOKEN="change-me"

LINKEDIN_CLIENT_ID="change-me"
LINKEDIN_CLIENT_SECRET="change-me"

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="change-me"

# ─── INTERNAL ────────────────────────────────────────────────────────────────
# Protects /internal/queues Bull Board dashboard
INTERNAL_API_KEY="change-me"
