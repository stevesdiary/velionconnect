{
  "info": {
    "name": "VelionConnect API",
    "_postman_id": "b1a9c0de-1234-4a5b-9c0d-velionconnect01",
    "description": "VelionConnect REST API collection with sample payloads.\n\n## Setup\n1. Import the accompanying environment `velionconnect.postman_environment.json`.\n2. Set `baseUrl` (default `http://localhost:3001/api/v1`).\n3. Run **Auth > Login** (or **Register**). The server sets HttpOnly `access_token` / `refresh_token` cookies which Postman stores in its cookie jar and sends automatically on subsequent requests.\n4. Alternatively, paste an access token into the `accessToken` variable to use Bearer auth.\n5. Fill in `orgSlug` and `workspaceSlug` after creating an organization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "orgSlug", "value": "acme-retail" },
    { "key": "workspaceSlug", "value": "support" },
    { "key": "accessToken", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "contactId", "value": "" },
    { "key": "connectedAccountId", "value": "" },
    { "key": "postId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"fullName\": \"Jane Doe\",\n  \"password\": \"sup3r-secret-pw\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"sup3r-secret-pw\"\n}"
            }
          }
        },
        {
          "name": "2FA Verify",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/2fa/verify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "2fa", "verify"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tempToken\": \"<from login response>\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "2FA Setup",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/2fa/setup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "2fa", "setup"]
            }
          }
        },
        {
          "name": "2FA Enable",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/2fa/enable",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "2fa", "enable"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"123456\"\n}" }
          }
        },
        {
          "name": "Magic Link - Request",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/magic-link/request",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "magic-link", "request"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"jane@example.com\"\n}" }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
